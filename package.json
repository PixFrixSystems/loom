{
  "name": "loom",
  "productName": "Loom",
  "version": "0.1.13",
  "description": "One window for all your projects and Claude chats",
  "private": true,
  "main": "out/main/index.js",
  "author": "PixFrix",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/smoke.mjs --live",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "remote:types": "wrangler types remote/worker/runtime.d.ts --config remote/wrangler.jsonc",
    "remote:typecheck": "npm run remote:types && tsc --noEmit -p remote/tsconfig.worker.json && tsc --noEmit -p remote/tsconfig.json",
    "remote:build": "vite build --config remote/vite.config.mts",
    "remote:dev": "npm run remote:build && wrangler dev --config remote/wrangler.jsonc --port 8787",
    "remote:deploy": "npm run remote:build && wrangler deploy --config remote/wrangler.jsonc"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.72.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.65.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0",
    "zustand": "^5.1.0"
  }
}
