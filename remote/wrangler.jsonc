// remote.loom.baby: the phone page (the files in dist) and the relay (worker/index.ts), as one
// Cloudflare Worker. Everything here fits the Workers Free plan.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "loom-remote",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "remote.loom.baby", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The relay's addresses go to the Worker; everything else is a file of the page.
    "run_worker_first": ["/v1/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed, which is the kind the Free plan includes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
